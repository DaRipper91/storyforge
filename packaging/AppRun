#!/bin/sh
# AppImage entry point. Default: offline Godot client (no server, no API key).
# `AppRun web [args]`: the FastAPI launcher (needs STORYFORGE_GEMINI_API_KEY).
HERE="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" = "web" ]; then
    shift
    exec "$HERE/usr/bin/storyforge" "$@"
fi
exec "$HERE/usr/bin/storyforge-client" "$@" -- --backend=local
