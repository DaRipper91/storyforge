[configuration]
entry_symbol = "d2_engine_init"
compatibility_minimum = "4.2"

[libraries]
linux.debug.x86_64 = "res://bin/libd2_engine.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libd2_engine.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libd2_engine.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libd2_engine.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/libd2_engine.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libd2_engine.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/libd2_engine.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/libd2_engine.windows.template_release.arm64.dll"
macos.debug = "res://bin/libd2_engine.macos.template_debug.framework"
macos.release = "res://bin/libd2_engine.macos.template_release.framework"
